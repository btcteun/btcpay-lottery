# Copy to .env and fill in. Never commit .env.
BTCPAY_URL=https://your-btcpay.example
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
# API key needs: btcpay.store.canviewinvoices + btcpay.store.cancreateinvoice

# Public address of this page; BTCPay redirects buyers back here after payment
PUBLIC_URL=https://lottery.example.com

# ISO 8601 with timezone offset
LOTTERY_START=2026-09-13T10:00:00+02:00
LOTTERY_END=2026-09-13T17:00:00+02:00

TICKET_PRICE_SATS=2100
MAX_TICKETS_PER_INVOICE=50

# Generate with: python3 -c 'import secrets;print(secrets.token_hex(32))'
ADMIN_TOKEN=

# invoice = show real BTCPay invoice IDs as ticket numbers (default)
# salted  = show a salted hash instead; requires TICKET_SALT
TICKET_MODE=invoice
TICKET_SALT=

# Optional: point at your own node instead of mempool.space
BLOCK_API=https://mempool.space/api

# Name of the state file inside ./data on the host (e.g. one per event)
DATA_FILENAME=lottery_2026-09-13.json

# Number of prizes drawn from the same block (winning ticket leaves the pool,
# the buyer's other tickets stay in). Optional labels, "|" separated.
PRIZE_COUNT=1
PRIZE_LABELS=
